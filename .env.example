# Base URL of the school's Bakaláři instance (no trailing slash)
BAKALARI_BASE_URL=https://bakalari.spseplzen.cz
# Optional: web login used when /Timetable/Public requires authentication.
# Leave both empty for schools that publish timetables without login.
BAKALARI_USERNAME=
BAKALARI_PASSWORD=
# Seconds to cache fetched pages (default 600)
BAKALARI_CACHE_TTL=600
# HTTP timeout in seconds (default 20)
BAKALARI_TIMEOUT=20
# Max parallel requests to the school server (default 4)
BAKALARI_MAX_CONCURRENCY=4
